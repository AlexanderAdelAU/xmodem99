;
;****************************************
;
;	NAME XMODEM
;	PURPOSE : TO TRANSFER FILES BETWEEN MACHINES
;	USING THE XMODEM PROTOCOL.  WRITTEN BY ALEXANDER CAMERON
;	VERSION 1.3	14TH MAY 2020 - DURING THE COVID-19 PANDEMIC IN ADELAIDE
;	VERSION 1.4	24TH MAY 2020 - ADDED SECTOR BY SECTOR DIRECT WRITING TO DISC
;
;	USAGE:  XMODEM <FILENAME> [-HHHH]
;	        -HHHH = LOAD ADDRESS IN HEX (1 TO 4 DIGITS) WRITTEN TO THE FCB.
;	        DEFAULT IS TPA (1000H).  E.G.  XMODEM ABC.COM -0500
;	version 6.5 - Added EXE type detection
;	version 6.6 - Added optional -HHHH load address switch (default TPA)
;	version 5.9 - XMODEM-CRC receive: opens with 'C', falls back to
;	              the one-byte checksum if the sender does not answer
;       version 7.0 - Added XMODEM-1K (1024 byte packet) auto-detect support
;
;
; -------- 3. MESSAGE BLOCK LEVEL PROTOCOL

;Link to this description;  http://textfiles.com/programming/ymodem.txt
;
; Each block of the transfer looks like:
; <SOH><blk #><255-blk #><--128 data bytes--><cksum>
; <STX><blk #><255-blk #><--1024 data bytes--><cksum>
;
;**************************************
;
; THESE XOP ARE DEFINED IN THE MONITOR.   
; NOTE XOP WORSPACES ARE OVERLAPPED 
; SO THAT ALL REGISTERS R0 TO R7 ARE SHARED.
;
;

;	DXOP	SETREG,2
	DXOP	CALL,6
	DXOP	RET,7
	DXOP	PUSH,8
	DXOP	POP,9
	DXOP	WHEX,10		;WRITE OUT A 16 BIT HEX VALUE
;	DXOP	RHEX,11		;READ IN A 16 BIT HEX VALUE
;	DXOP	WRITE,12		;WRITE CHAR IN MSB
;	DXOP	READ,13		;READ CHAR IN MSB
	DXOP	MESG,14		;OUTPUT NULL TERMINATED MESSAGE
;
R0	EQU	0
R1	EQU	1
R2	EQU	2
R3	EQU	3
R4	EQU	4
R5	EQU	5
R6	EQU	6
R7	EQU	7
R8	EQU	8
SL	EQU	9
R9	EQU	9
SP	EQU	10
R11	EQU	11
R12	EQU	12
R13	EQU	13
R14	EQU	14
R15	EQU	15
;
;
;	BDOS EQUATES	
;
TPA:	EQU	01000H		;DEFAULT START ADDRESS
BDOS:	EQU	84H		;BDOS POINTER.
SHELL:	EQU	80H		;SHELL POINTER
CMDLINE:	EQU	0A0H		;SHELL COMMAND LINE POINTER
COMM_BUF:	EQU	0A4H		;POINTER TO COMMON BRIDGE BUFFER
COMM_FCB:	EQU	0ACH		;COMMON FCB

;LOCAL ADDRESSES
SECTOR_BUFFER:	EQU	COMM_BUF
FCB:	EQU	COMM_FCB

NAMSIZ	EQU	11		;DIRECTORY NAME SIZE
EXTSIZ	EQU	3
COUT	EQU	2
SELDSK	EQU	14
OPEN	EQU	15
FCLOSE	EQU	16
ERAFIL	EQU	19
MAKFIL	EQU	22
WRSEQ	EQU	21
SETDMA	EQU	26
;
;---FCB	EQUATES
;
NAM	EQU	0
FTY	EQU	11
FLA	EQU	16
FSB	EQU	12
FSZ	EQU	14
CRN	EQU	26
EXTOFF	EQU	NAMSIZ-EXTSIZ
EXTOFF1	EQU	NAMSIZ-EXTSIZ+1
EXTOFF2	EQU	NAMSIZ-EXTSIZ+2

;
; FILE TYPES - must match EXT_TAB order exactly
;
SYS     EQU     0       ; System file (default/unknown)
COM     EQU     1       ; Flat binary executable
EXE     EQU     2       ; Paged chain format executable (link99 v3.9.10+)
TXT     EQU     3       ; Text file
BAS     EQU     4       ; BASIC source
PRO     EQU     5       ; Procedure/overlay

;
;
	AORG	TPA
	JMP	START
;
;	MISC DEFINITIONS
;
SPACE	BYTE	20H
SWITCH	BYTE	'-'		;COMMAND LINE SWITCH
EXT	BYTE	'.'		;COMMAND LINE SWITCH
	EVEN
BYTSEC	EQU	512
RECSIZE 	EQU	128

REC_COUNT	WORD	4		;THIS ASSUME 4 128 BYTE RECORDS PER sector
NAMED_FILE	WORD	0		;IF A NAMED FILE WAS ON THE COMMAND LINE THIS IS SET
LOADADDR	WORD	TPA		;LOAD ADDRESS WRITTEN TO THE FCB: TPA UNLESS -HHHH GIVEN
MFTY	BYTE	0		;USE MSB
BLKSIZE		WORD	128		;CURRENT BLOCK SIZE (128 OR 1024)
DISK_PTR	WORD	0		;TRACKS POSITION IN THE OS SECTOR BUFFER
	EVEN
;
;	STANDARD EXIT PATTERN
;
EXIT:	CLR	R1		;RETURN CODE FOR SHELL
	B	@SHELL		;NEED TO CALL SHELL INIT BECAUSE WE HAVE ALTERED WP
CMD_ERROR:	B	@CMDERR
;
;	XMODEM ENTRY POINT
;
START:	LI	R0,VERSION
	MOV	R0,@ERR_MSG_ADDR		;MESSAGE TO PRINT
	CALL	@PRINTMSG
;
; MOVE THE FILENAME TO THE FCB
; XMODEM <FILENAME> <switches>
;
	MOV	@CMDLINE,R3		;GET CMD BUFFER POINTER
START00	CB	*R3+,@SPACE	 	;LOOK FOR SPACES BETWEEN COMMAND AND ARGS
	JL	CMD_ERROR
	JNE	START00		;JUMP OVER APP NAME

START01	CB	*R3+,@SPACE		;NOW JUMP OVER SPACES
	JEQ	START01
	DEC	R3	 	;BACK UP TO 1ST CHAR
;
;	NOW LOOK FOR ARGUMENTS AND SWITCHES
;
START02	CALL	@CHKCHAR		;IF VALID CHAR ASSUME FILE NAME ARG
	JEQ	START03
	JMP	CMD_ERROR		;IF NOT FILENAME ASSUME ERROR
;
; 	TRY AND PARSE THE FILE NAME TO BE UPLOADED
;
START03	MOV	@FCB,R4
	CALL	@PARSENAME
	CALL	@GETSWITCH		;OPTIONAL -HHHH LOAD ADDRESS, R3 IS JUST PAST THE FILE NAME

;--- DETECT FILE TYPE FROM EXTENSION, STORE IN FCB+FTY ---
	LI	R0,EXT_TAB		; START OF EXTENSION TABLE
	CLR	R9			; R9 = TYPE CODE, START AT 0 (SYS)
	MOV	@FCB,R8			; R8 = FCB BASE ADDRESS
FTYLOOP:
	MOV	R0,R5			; R5 = ENTRY POINTER (R0 CANT INDEX)
	MOVB	*R5+,R3			; BYTE 1 OF TABLE ENTRY
	JEQ	FTYNONE			; ZERO TERMINATOR - NO MATCH
	INC	R9			; NEXT TYPE CODE (1=COM, 2=EXE...)
	CB	R3,@EXTOFF(R8)		; COMPARE BYTE 1
	JNE	FTYNEXT
	MOVB	*R5+,R3			; BYTE 2 OF TABLE ENTRY
	CB	R3,@EXTOFF1(R8)		; COMPARE BYTE 2
	JNE	FTYNEXT
	MOVB	*R5,R3			; BYTE 3 OF TABLE ENTRY
	CB	R3,@EXTOFF2(R8)		; COMPARE BYTE 3
	JEQ	FTYFOUND		; ALL 3 BYTES MATCH
FTYNEXT:
	AI	R0,3			; ADVANCE TO NEXT TABLE ENTRY
	JMP	FTYLOOP
FTYNONE:
	CLR	R9			; NO MATCH - SYS = 0
FTYFOUND:
	SWPB	R9			; PLACE TYPE CODE IN LOW BYTE FOR MOVB
	MOVB	R9,@MFTY		; STORE TYPE CODE IN FCB

;---------------------------------------------------------
; WE HAVE THE FILE NAME IN THE FCB SO CREATE THE NAMED FILE
;----------------------------------------------------------
	LI	R2,ERAFIL 		;PURGE IF ALREADY EXITS
L_START:	MOV	@FCB,R3
	CALL	@BDOS
	LI	R2,MAKFIL
	MOV	@FCB,R3
	CALL	@BDOS	 	;TRY TO MAKE THE FILE
	MOV	R1,R1	 	;SUCCESS ?
	JLT	MKERR	 	;MAKE ERROR
	CLR	R0
	MOV	@FCB,R3
	MOV	R0,@CRN(R3)		;BEGIN AT FIRST RECORD
	MOV	@LOADADDR,@FLA(R3)	;LOAD ADDRESS: TPA OR THE -HHHH SWITCH
	MOVB	@MFTY,@FTY(R3)		;RECOVER FILE TYPE
;
;	BEGIN RECEIVING THE FILE BY LOADING INTO THE BUFFER
;	WRITE SECTOR BY SECTOR TO DISC
;
	SETO	@NAMED_FILE		;FILE TO BE ERASED IF THERE IS AN ERROR
	CALL	@RECV_FILE		;RECEIVE THE FILE AND WRITE IT SECTOR BY SECTOR
	CALL	@CLOSE_FILE
	LI	R0, SUCCESS
	MOV	R0,@ERR_MSG_ADDR
	CALL	@PRINTMSG
	B	@EXIT


	; PARSENAME PARSE THE FILE NAME FROM THE COMMAND LINE
PARSENAME:	MOV	@FCB,R4	 	;POINT TO FCB AND CMDLINE + 1
	CLR	*R4		;ZERO TO DETECT FILENAME
	LI	R2,NAMSIZ - EXTSIZ	;NAME LENGTH

PARSE1:	CALL	@CHKCHAR
	JNE	FILLNAME		;NOT VALID
	MOVB	*R3+,*R4+		;STORE CHAR IN FCB
	DEC	R2
	JEQ	FINDDOT
	JMP	PARSE1	 	;KEEP GOING
FILLNAME:	CI	R2,NAMSIZ - EXTSIZ	;NO FILE FOUND
	JEQ	FINDDOT
	CALL	@PADSPACE		;FILL NAMSIZ WITH SPACES IF REQUIRED

FINDDOT:	CB	*R3+,@EXT		;'.'?
	JEQ	GETEXT		;YES?  GO GET THE 3 EXTENSION CHARS
	DEC	R3		;BACKUP SINCE CB INCRMENTED IT
	LI	R2,EXTSIZ
	MOV	@FCB,R4
	AI	R4,NAMSIZ - EXTSIZ

	CALL 	@PADSPACE
	RET
	; GET FILE EXTENSION
GETEXT:	LI	R2,EXTSIZ		;EXTENSION ARE 3 BYTES LONG
	MOV	@FCB,R4
	AI	R4,NAMSIZ - EXTSIZ
;
NEXTEXT:	CALL	@CHKCHAR		;IS IT A VALID NAME CHAR?
	JNE	FILLEXT		;IF SPACE/CRE ETC GO PAD THE REST
	MOVB	*R3+,R1			;GET CHAR (HIGH BYTE)
	SRL	R1,8			;MOVE ASCII CHAR TO LOW BYTE
	CI	R1,0061H		;LOWERCASE 'a'?
	JL	EXTSTORE		;NO - LEAVE CHAR UNCHANGED
	CI	R1,007AH		;LOWERCASE 'z'?
	JH	EXTSTORE		;NO - LEAVE CHAR UNCHANGED
	ANDI	R1,00DFH		;YES - FORCE a-z TO UPPERCASE
EXTSTORE:	SWPB	R1			;PUT CHAR BACK IN HIGH BYTE FOR MOVB
	MOVB	R1,*R4+			;STORE CHAR IN FCB
	DEC	R2
	JEQ	DONE
	JMP	NEXTEXT

FILLEXT:	CALL	@PADSPACE		;FILL THE REMAINING CHARS WITH SPACE
	MESG	@FCB
DONE:	RET

; EXTENSION TABLE - 3 bytes per entry
EXT_TAB:
        TEXT    'COM'   ; TYPE 1 - flat binary executable
        TEXT    'EXE'   ; TYPE 2 - paged chain format executable
        TEXT    'TXT'   ; TYPE 3 - text file
        TEXT    'BAS'   ; TYPE 4 - BASIC source
        TEXT    'PRO'   ; TYPE 5 - procedure/overlay
EXT_END_B:
        BYTE    0       ; TABLE TERMINATOR
        EVEN
;---------------------------------------------------------
CHKCHAR:	MOVB	*R3,R1		; Load char into high byte
	SRL	R1,8		; Move to low byte
	CI	R1,'0'		; Compare with '0'
	JL	INVALID		; If it's < '0', it's a dot or symbol
	CI	R1,'9'		; 0-9?
	JLE	VALID		; If less or equal, it's valid
	ANDI	R1,00DFH	; Force uppercase (0xDF)
	AI	R1,-'A'		; Offset by 'A'
	CI	R1,001AH	; 26 in hex
	JH	INVALID		; If > 25, it's out of range

VALID:	CLR	R1		; Valid: set R1 to 0
	JMP	SETFLAG		; Go set the EQ bit

INVALID:	LI	R1,1		; Invalid: set R1 to 1

SETFLAG:	MOV	R1,R1		; Set EQ bit (1 if R1=0, 0 if R1=1)
	RET

;---------------------------------------------------------
PADSPACE:	MOV	R2,R2		; IS THE SPACE COUNT ZERO?
	JLE	PADRETS		; YES, NOTHING TO DO
PADLOOP:	MOVB	@SPACE,*R4+	; STORE SPACE (0X20) AND INC POINTER
	DEC	R2		; REDUCE REMAINING COUNT
	JH	PADLOOP		; LOOP IF R2 IS STILL GREATER THAN 0
PADRETS:	RET			; RETURN
;
;=======================================================
MKERR:	LI	R0,MAKMSG
	B	@LOAD_END

CMDERR:	LI	R0,CMDMSG
	B	@LOAD_END
;
;=======================================================
;	CLOSE THE FILE, FLUSH REMAINDER IF PRESENT
;=======================================================
CLOSE_FILE:
	MOV	@REC_COUNT,R0
	JEQ	CLS_1
	CALL	@WRITE_SECTOR	;FLUSH REMAINDER

CLS_1:	LI	R2,FCLOSE	 	;NOW CLOSE THE FILE
	MOV	@FCB,R3
	CALL	@BDOS
	RET
;
;****************************************************************************
; WRITE 2 SECTOR'S WORTH OF DATA (512 BYTES) USING THE OS DMA BUFFER
;*****************************************************************************
;
WRITE_SECTOR:
	LI	R2,SELDSK
	CLR	R3
	CALL	@BDOS
	MOV	@SECTOR_BUFFER,R3	; MUST USE OS BUFFER FOR DMA
	LI	R2,SETDMA
	CALL	@BDOS
	LI	R2,WRSEQ
	MOV	@FCB,R3
	CALL	@BDOS
	CLR	R1
	MOV	R1,R1	 		;WRITE ERROR ?
	JLT	WS_E	 		;YES
	RET
WS_E:	B	@WRITE_ERROR
;	
; ERROR MESSAGE AND HANDLING
;
ERRBASE	EQU	$+2
CRLF	BYTE	0DH,0AH,0
	EVEN
CMDMSG	TEXT	"** USAGE: XMODEM <FILENAME> [-HHHH]  (HHHH = HEX LOAD ADDRESS, DEFAULT 1000) **"
	BYTE	0DH,0AH,0
	EVEN
ADRMSG	TEXT	"** BAD LOAD ADDRESS - USE -HHHH, 1 TO 4 HEX DIGITS **"
	BYTE	0DH,0AH,0
	EVEN
LOADMSG	TEXT	"LOAD ADDRESS: "
	BYTE	0
	EVEN
MAKMSG	TEXT	"** FILE CREATE ERROR **"
	BYTE	0DH,0AH,0
	EVEN
WRITE_MESSAGE
	TEXT	"** OUTPUT FILE WRITE ERROR **"
	BYTE	0DH,0AH,0
	EVEN
MDMMSG  	BYTE	0DH,0AH
	TEXT	"** FATAL LOAD ERROR **"
	BYTE	0
	EVEN
SECT_ERROR_MSG	BYTE	0DH,0AH
	TEXT	"** RECEIVE SECTOR ERROR **"
	BYTE	0DH,0AH,0
	EVEN
SEQ_ERROR_MSG
	BYTE    0DH,0AH
	TEXT	"** SECTOR OUT OF SEQUENCE ERROR **"
	BYTE	0DH,0AH,0
	EVEN
END_MESSAGE
	TEXT	"LOAD_END"
	BYTE	0DH,0AH,0
	EVEN
VERSION	TEXT	"MODEM VERSION 1.9P - READY."
	BYTE	0DH,0AH,0
	EVEN
SAVING	TEXT	"SAVING FILE.."
	BYTE	0DH,0AH,0
	EVEN
SUCCESS	TEXT	"SUCCESS."
	BYTE	0DH,0AH,0
	EVEN
CLOSE_MESSAGE
	TEXT	"***ERROR CLOSING FILE ***"
	BYTE	0DH,0AH,0
	EVEN
LARGE_FILE_MSG
	TEXT	"***ERROR CLOSING FILE ***"
	BYTE	0DH,0AH,0
	EVEN
ERR_MSG_ADDR	WORD	0   ;ADDRESS OF MESSAGE TO BE OUTPUT


;
;	
;  LOAD THE RECIEVED FILE OR MODULE INTO MEMDORY
;
NAK		BYTE	15H
ACK		BYTE	06H
SOH		BYTE	01H
STX		BYTE	02H		; XMODEM 1K HEADER
EOT		BYTE	04H
ETB		BYTE	017H
CAN		BYTE	018H
NULL		BYTE	000H
RECVD_SECT_NO	BYTE	0		;RECEIVED RECORD NUMBER	
COMP_REC_NO		BYTE	0		;INVERED NUMBER OF RECEIVED RECORD NUMBER
SECTNO		BYTE	0		;PREVIOUS RECEIVED RECORD NUMBER
CHECKSUM		BYTE	0
REC_TIME_OUT	BYTE	0FFH
CCHAR		BYTE	43H		;'C' - ASKS THE SENDER FOR CRC-16 MODE
		EVEN
;
CRCMODE		WORD	1		;NONZERO = CRC-16, ZERO = CHECKSUM
CRCACC		WORD	0		;RUNNING CRC FOR THIS BLOCK
CRCRCV		WORD	0		;CRC RECEIVED WITH THIS BLOCK
CRCPOLY		WORD	1021H		;XMODEM POLYNOMIAL
CPROBE		WORD	40
GOTBLK		WORD	0		;NONZERO ONCE A BLOCK HAS BEEN ACCEPTED
		EVEN
;
RECV_FILE:
	MOV	@SECTOR_BUFFER,R0
	MOV	R0,@DISK_PTR		; INIT DISK POINTER TO OS BUFFER START
	LI	R0,4
	MOV	R0,@REC_COUNT		; INIT RECORD COUNT
	CLR	R0
	MOV	R0,@SECTNO
	LI	R0,1
	MOV	R0,@CRCMODE
	LI	R0,40
	MOV	R0,@CPROBE
	CLR	R0
	MOV	R0,@GOTBLK
;
; THIS IS THE MAIN RECEIVE LOOP
;
RECV_LOOP:	LI	R0,64
	MOV	R0,@RETRY

RECV_HDR:	LI	R1,8
	CALL	@RECV_WAIT		;LOOP UNTIL SENDER DONE BEFORE SENDING NAK
	CB	R2,@REC_TIME_OUT	;TIMEOUT ERROR ?
	JNE	RHNTO		;NO TIMEOUT,

RECV_SECT_ERR:
	LI	R1,64
	CALL	@RECV_WAIT		;LOOP UNTIL SENDER DONE BEFORE SENDING NAK
	CB	R2,@REC_TIME_OUT	;TIMEOUT ERROR ?
	JNE	RECV_SECT_ERR	;NO, THEN STILL STUFF ARRIVING
	DEC	@RETRY
	JNE	$+6
	B	@SECTOR_ERROR	;FORCE AN END

	MOV	@CRCMODE,R0
	JEQ	SEND_NAK		;ALREADY IN CHECKSUM MODE
	MOV	@GOTBLK,R0
	JNE	SEND_NAK		;PAST THE HANDSHAKE: NAK ON ERRORS
	DEC	@CPROBE
	JEQ	FALLBACK
	MOVB	@CCHAR,R2
	CALL	@TX
	JMP	RECV_HDR
FALLBACK:
	CLR	@CRCMODE		;SENDER IGNORED 'C', USE CHECKSUM
SEND_NAK:
	MOVB	@NAK,R2
	CALL	@TX
	JMP	RECV_HDR
;
; GOT CHAR MUST BE SOH OR STX
;        
RHNTO:
	CB	R2,@SOH
	JEQ	GOT_SOH
	CB	R2,@STX
	JEQ	GOT_STX		; DETECT AND HANDLE 1K BLOCKS
	CB	R2,@EOT
	JNE	$+6
	B	@GOT_EOT

	JMP	RECV_SECT_ERR
;
GOT_SOH:
	LI	R6,128
	MOV	R6,@BLKSIZE
	JMP	GOT_HDR_COMMON

GOT_STX:
	LI	R6,1024
	MOV	R6,@BLKSIZE

GOT_HDR_COMMON:
	LI	R4,MY_BUFFER		; ALWAYS STREAM THE RAW PACKET INTO SAFE TPA MEMORY
	LI	R1,2		;ZERO WAIT TIME
	CALL	@RECV_WAIT		;GET RECORD NUMBER
	MOVB	R2,@RECVD_SECT_NO	;
	CLR	R1		;ZERO WAIT TIME
	CALL	@RECV_WAIT		;GET INVERTED RECORD NUMBER
	MOVB	R2,@COMP_REC_NO
;
; NOW GET BYTES OF DATA
;
	CLR	R5		;CHECKSUM
	CLR	@CRCACC			;AND THE CRC

NEXT_CHR:
	LI	R1,2		;NOMINAL WAIT TIME
 	CALL	@RECV_WAIT
	MOVB	R2,*R4+			;UPDATE THE RECORD POINTER
	AB	R2,R5			;UPDATE THE CHECKSUM
	BL	@CRCUPD			;AND THE CRC (BL, NOT CALL - SEE CRCUPD)
	DEC	R6			;COUNT DOWN THE NUMBER OF BYTES
	JNE	NEXT_CHR
;
; WAIT FOR CHECKSUM TO BE RECEIVED
;
	LI	R1,2		;NOMINAL WAIT TIME
	CALL	@RECV_WAIT		;GET FIRST CHECK BYTE INTO R2
	MOVB	R2,@CHECKSUM		;CHECKSUM MODE USES IT AS IS
	MOV	R2,R0
	ANDI	R0,0FF00H		;CRC MODE: THIS IS THE HIGH BYTE
	MOV	R0,@CRCRCV
	MOV	@CRCMODE,R1
	JEQ	TRAIL_DONE
	LI	R1,2
	CALL	@RECV_WAIT		;GET THE CRC LOW BYTE
	SRL	R2,8
	A	R2,@CRCRCV		;CRCRCV = (HIGH << 8) + LOW
TRAIL_DONE:
;
; CHECK WE HAVE CONSISTENT RECORD NUMBERS AND CHECKSUMS
;
	MOVB	@RECVD_SECT_NO,R0
	INV	R0			;INVERT RECORD 1
	CB	R0,@COMP_REC_NO		;INVERTED VALUE OF RECVD SECT NUMBER
	JNE	RECV_SECT_ERR		;BAD RECORD SO TRY AGAIN
	MOV	@CRCMODE,R1
	JEQ	CK_SUM
	C	@CRCRCV,@CRCACC		;CRCS MATCH ?
	JNE	RECV_SECT_ERR		;NO, SO TRY AGAIN
	JMP	CK_OK
CK_SUM:
	MOVB	@CHECKSUM,R2
	CB	R2,R5			;CHECKSUMS MATCH ?
	JNE	RECV_SECT_ERR		;CHECKSUMS DON'T MATCH SO TRY AGAIN
CK_OK:

;-----------------------------------------------
; IF DUPLICATE KEEP THE LATEST
;-----------------------------------------------
	MOVB	@RECVD_SECT_NO,R1 		;RECEIVED SECTOR NUMBER
	MOVB	@SECTNO,R0			;GET PREVIOUS SECTOR NUMBER
	CB	R1,R0			;SENDER HAS RESENT THE SAME SECTOR SO PROBABLY MISSED THE ACK, SO RESEND
	JEQ	DO_ACK
	AI	R0,1*256			;CALCULATE WHAT SHOULD BE THE NEXT RECORD NUMBER (ADD ONE)
	CB	R1,R0			;IF EQUAL THEN THAT IS WHAT WE EXPECTED
	JEQ	GOT_RECORD			;MATCH IF SO GOOD AND IN SEQUENCE
	JMP	RCV_SEQ_ERROR		;FATAL ERROR AS WE HAVE LOST A RECORD AND CANNOT RECO	

DO_ACK:
 	MOVB	@ACK,R2
	CALL	@TX
	B	@RECV_LOOP

TEMP_COUNT:	WORD	0
RCV_SEQ_ERROR:
	JMP	SEQUENCE_ERROR					  
;
GOT_RECORD:
	MOVB	@RECVD_SECT_NO,@SECTNO
	LI	R0,1
	MOV	R0,@GOTBLK

	; PACKET IS GOOD. NOW COPY FROM TPA TO OS BUFFER
	LI	R4,MY_BUFFER
	MOV	@BLKSIZE,R5
	SRL	R5,7			; R5 = 1 (SOH) OR 8 (STX)

COPY_RECS:
	MOV	@DISK_PTR,R6
	LI	R7,128			; COPY 128 BYTES
C_LOOP:
	MOVB	*R4+,*R6+
	DEC	R7
	JNE	C_LOOP
	MOV	R6,@DISK_PTR		; UPDATE OS BUFFER POINTER

	DEC	@REC_COUNT
	JNE	NO_FLUSH

	; OS DISK BUFFER IS FULL (512 BYTES), FLUSH IT
	INC	@TEMP_COUNT
	PUSH	R4			; PROTECT OUR MY_BUFFER READ POINTER
	PUSH	R5			; PROTECT OUR LOOP COUNTER
	CALL	@WRITE_SECTOR		; FLUSH SAFELY USING OS MEMORY
	POP	R5
	POP	R4

	LI	R0,4
	MOV	R0,@REC_COUNT		; RESET RECORD COUNT
	MOV	@SECTOR_BUFFER,R0
	MOV	R0,@DISK_PTR		; RESET DISK POINTER TO START OF OS BUFFER

NO_FLUSH:
	DEC	R5
	JNE	COPY_RECS

	JMP	DO_ACK
;
RETRY:	WORD	0

SEQUENCE_ERROR:	LI	R0, SEQ_ERROR_MSG
	JMP	LOAD_END

SECTOR_ERROR:	LI	R0,SECT_ERROR_MSG
	JMP	LOAD_END

WRITE_ERROR:	LI	R0,WRITE_MESSAGE
	JMP	LOAD_END

LOAD_END:	MOV	R0,@ERR_MSG_ADDR

LE_1:	MOVB	@CAN,R2		;CANCEL THE TRANSFER
	CALL	@TX
	LI	R1,8		;WAIT PERIOD
	CALL	@RECV_WAIT
	CB	R2,@REC_TIME_OUT	;TIMEOUT ERROR ?
	JNE	LE_1

	CALL	@PRINTMSG
LE_2	LI	R1,128
	CALL	@RECV_WAIT
	CB	R2,@REC_TIME_OUT	;TIMEOUT ERROR ?
	JNE	LE_2
	MOV	@NAMED_FILE,R0
	JEQ	LE_3
;
	LI	R2,ERAFIL 		;PURGE IF AN ERROR
	MOV	@FCB,R3
	CALL	@BDOS
LE_3	B	@EXIT

GOT_EOT:
	MOVB	@ACK,R2
	CALL	@TX		;SEND ACK RESPONSE
 	RET

PRINTMSG:	MOV	@ERR_MSG_ADDR,R0
PM1	MOVB	*R0+,R3
	JEQ	PM2
	SWPB	R3
	LI	R2,2		;BDOS CONOUT
	PUSH	R0
	CALL	@BDOS
	POP	R0
	JMP	PM1
PM2	RET
;
RECV_WAIT:	SLA	R1,8	        	;TIME OUT FIGURE
SWAIT1:	CALL	@RXSTAT
	JNE	RX		;GO GET CHAR AND RETURN
	DEC	R1
	JNE	SWAIT1
	SETO	R2		;SHOW  TIMEOUT ERROR
	RET

RXSTAT:	CLR	R0		;0-> not ready
	LI	R12,80H
	TB	21		;RECEIVE BUFFER REG FULL ?
	JNE	RX2		;NO
	INC	R0		;YES
RX2:	MOV	R0,R0		;SET FLAGS
	RET

CRCUPD:
	MOV	@CRCACC,R1
	MOV	R2,R0
	ANDI	R0,0FF00H
	XOR	R0,R1			;CRC = CRC XOR (BYTE << 8)
	LI	R0,8
CRCB:	SLA	R1,1
	JNC	CRCNX
	XOR	@CRCPOLY,R1
CRCNX:	DEC	R0
	JNE	CRCB
	MOV	R1,@CRCACC
	B	*R11

RX_FLUSH:
	LI	R0,1024
	LI	R12,80H
RX3	DEC	R0
	JEQ	RX4
	TB	21		;RECEIVE BUFFER REG FULL ?  GET RID OF JUNK
	JEQ	RX3		;NO
RX4	STCR	R2,8
	SBZ	18		;SHOW WE RECEIVED CHARACTER
	MOV	R0,R0		;SET FLAGS
	RET

RX:	CLR	R2
	LI	R12,80H
	STCR	R2,8
	SBZ	18		;SHOW WE RECEIVED CHARACTER
	RET

WAIT	SETO	R0
WAIT_2	DEC	R0
	JNE	WAIT_2
	RET
;
TX:	LI	R1,5000
	LI	R12,80H
TX2	CALL	@TXSTAT
	JNE	TX3
	DEC	R1
	JNE	TX2		
	RET			;RETURN WITH ZERO IF TIMEOUT
TX3	SBO	16		;TURN ON THE TRANSMITTER
	LDCR	R2,8
	SBZ	16		;TURN OFF TRANSMITTER
	MOV	R1,R1		;STATUS
	RET

TXSTAT	CLR	R0		;0-> not ready
	LI	R12,80H
	SBO	16		;TURN ON THE TRANSMITTER
TX_STAT1
	TB	22		;WAIT FOR XBRE =1
	JNE	TX_STAT1
	SBZ	16		;TURN OFF TRANSMITTER
	INC	R0	
	MOV	R0,R0		;set flags
	RET

CRUBASE: 	EQU	0080H
CTL02:	BYTE	4BH		;43H FOR A 3 MHZ CLOCK 4B FOR A 4 MHZ CLOCK
	EVEN
BD57600:	WORD	9H 		;BAUD RATE = 57600
RESET9902:
	LI	R12,CRUBASE
	SBO	31		;RESET TMS9902
	LDCR	@CTL02,8
	SBZ	13		;DO NOT SET INTERVAL REGISTER
	LDCR	@BD57600,12 		;INT RECV/TXMT DATA RATE
	LDCR	@BD57600,11
	STCR	R7,8		;PULL OUT ANY JUNK
	STCR	R7,8
	RET

GETSWITCH:	LI	R0,TPA
	MOV	R0,@LOADADDR		; DEFAULT LOAD ADDRESS
SW00	CB	*R3+,@SPACE		; SKIP SPACES AFTER THE FILE NAME
	JEQ	SW00
	DEC	R3			; BACK UP TO THE FIRST NON-SPACE
	CB	*R3,@SPACE		; END OF LINE (CR/NULL) ?
	JL	SWDONE			; YES - NO SWITCH, KEEP THE DEFAULT
	CB	*R3+,@SWITCH		; "-" ?
	JEQ	SW01
	B	@CMDERR			; ANYTHING ELSE AFTER THE FILE NAME IS A USAGE ERROR
SW01	CLR	R0			; HEX ACCUMULATOR
	CLR	R2			; DIGIT COUNT
SW02	MOVB	*R3+,R1			; NEXT CHAR (HIGH BYTE)
	SRL	R1,8			; TO LOW BYTE
	CI	R1,'0'
	JL	SWEND			; BELOW "0" (SPACE/CR/NULL) ENDS THE NUMBER
	CI	R1,'9'
	JH	SW03			; NOT 0-9, TRY A-F
	AI	R1,-'0'		; "0"-"9" -> 0-9
	JMP	SW04
SW03	ANDI	R1,00DFH		; FORCE UPPER CASE
	AI	R1,-'A'		; "A"-"F" -> 0-5
	CI	R1,5
	JH	SWERR			; NOT A HEX DIGIT
	AI	R1,10			; -> 10-15
SW04	INC	R2			; COUNT THE DIGITS
	CI	R2,4
	JH	SWERR			; MORE THAN 4 DIGITS
	SLA	R0,4			; MAKE ROOM FOR THE NEW DIGIT
	A	R1,R0			; ADD IT IN
	JMP	SW02
SWEND	MOV	R2,R2			; AT LEAST ONE DIGIT ?
	JEQ	SWERR			; NO - "-" ON ITS OWN
	MOV	R0,@LOADADDR		; OVERRIDE THE DEFAULT
SWDONE	LI	R0,LOADMSG		; ECHO THE ADDRESS THAT WILL BE RECORDED
	MOV	R0,@ERR_MSG_ADDR
	CALL	@PRINTMSG
	WHEX	@LOADADDR
	LI	R0,CRLF
	MOV	R0,@ERR_MSG_ADDR
	CALL	@PRINTMSG
	RET
SWERR	LI	R0,ADRMSG
	B	@LOAD_END		; MESSAGE AND EXIT, NOTHING ON DISC YET

PRINTFCB:	MOV	@FCB,R1
	LI	R0,16
PFCB1	WHEX	*R1+
	DECT	R0
	JNE	PFCB1
	RET

PRINTCMDL:	MOV	@CMDLINE,R1
	LI	R0,16
CMDL1	WHEX	*R1+
	DECT	R0
	JNE	CMDL1
	RET
;
MY_BUFFER	BSS	1024		; 1K SAFE TPA BUFFER

	END
